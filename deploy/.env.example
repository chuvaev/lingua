DOMAIN=lingua.example.com
REGISTRY=localhost:5000
TAG=latest

TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

POSTGRES_DB=lingua
POSTGRES_USER=lingua
POSTGRES_PASSWORD=change-me

# Идентификатор кластера Kafka. Задаётся один раз и больше не меняется,
# иначе Kafka не поднимется на существующем томе.
KAFKA_CLUSTER_ID=_QhjlwCjQSWrDL0HTboV9w

OLLAMA_BASE_URL=http://192.168.1.100:11434
# Модели должны быть заранее скачаны на том компе: ollama pull <имя>
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=bge-m3
